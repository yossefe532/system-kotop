{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "preDeployCommand": "python -m scripts.run_migrations",
    "startCommand": "python -m scripts.start_backend",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "env": {
    "APP_ENV": "production",
    "ENFORCE_SCHEMA_VERSION": "true",
    "ALLOW_BOOTSTRAP_ADMIN_FALLBACK": "false",
    "WALLET_LEDGER_ENABLED": "false",
    "VITE_ENABLE_DEMO_SEED": "false"
  }
}
